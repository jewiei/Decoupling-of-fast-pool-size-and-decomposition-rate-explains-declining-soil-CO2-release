def permutation_anova(df_fit, dep_var='k_fast', n_perm=5000,
                      random_state=42, year_order=None):

    rng = np.random.default_rng(random_state)
    sub = df_fit.dropna(subset=[dep_var]).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])

    formula = f'Q("{dep_var}") ~ C(Years) + C(Depth) + C(Years):C(Depth)'

    model_obs = ols(formula, data=sub).fit()
    aov_obs = sm.stats.anova_lm(model_obs, typ=2)
    F_obs_years = float(aov_obs.loc['C(Years)', 'F'])
    F_obs_depth = float(aov_obs.loc['C(Depth)', 'F'])
    F_obs_inter = float(aov_obs.loc['C(Years):C(Depth)', 'F'])
    p_par_years = float(aov_obs.loc['C(Years)', 'PR(>F)'])
    p_par_depth = float(aov_obs.loc['C(Depth)', 'PR(>F)'])
    p_par_inter = float(aov_obs.loc['C(Years):C(Depth)', 'PR(>F)'])

    F_null_years = []
    for _ in range(n_perm):
        sub_perm = sub.copy()
        years_shuffled = rng.permutation(
            sub_perm['Years'].astype(str).values)
        if year_order is not None:
            sub_perm['Years'] = pd.Categorical(
                years_shuffled, categories=year_order, ordered=True)
        else:
            sub_perm['Years'] = years_shuffled
        try:
            m = ols(formula, data=sub_perm).fit()
            a = sm.stats.anova_lm(m, typ=2)
            F_null_years.append(float(a.loc['C(Years)', 'F']))
        except Exception:
            continue

    def emp_p(F_obs, F_null):
        F_null = np.array(F_null, dtype=float)
        if len(F_null) == 0:
            return np.nan

        return float((np.sum(F_null >= F_obs) + 1) / (len(F_null) + 1))

    perm_table = pd.DataFrame([
        {'Effect': 'Years', 'F_obs': F_obs_years,
         'p_perm': emp_p(F_obs_years, F_null_years),
         'p_parametric_ANOVA': p_par_years,
         'Note': 'Valid permutation (Years labels shuffled)'},
        {'Effect': 'Depth', 'F_obs': F_obs_depth,
         'p_perm': np.nan,
         'p_parametric_ANOVA': p_par_depth,
         'Note': 'N/A: Depth labels not permuted; use ANOVA/MixedLM'},
        {'Effect': 'Years×Depth', 'F_obs': F_obs_inter,
         'p_perm': np.nan,
         'p_parametric_ANOVA': p_par_inter,
         'Note': 'N/A: interaction not permuted; use ANOVA/MixedLM'},
    ])

    return perm_table, {
        'F_null_years': F_null_years,
        'F_obs_years': F_obs_years,
        'n_valid_perm': len(F_null_years),
    }

