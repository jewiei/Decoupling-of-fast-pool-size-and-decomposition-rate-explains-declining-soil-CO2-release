def add_significance_to_axes(ax, data, var, tukey_result, order):
    if tukey_result is None:
        return
    try:
        rows = tukey_result._results_table.data[1:]
    except Exception:
        return
    sig_pairs = []
    for row in rows:
        if len(row) >= 7:
            g1, g2, meandiff, p, lower, upper, reject = \
                row[0], row[1], row[2], row[3], row[4], row[5], row[6]
            if str(reject) == 'True':
                sig_pairs.append((str(g1), str(g2), float(p)))
    y_max = data[var].max()
    y_min = data[var].min()
    y_range = y_max - y_min
    offset_step = y_range * 0.06 if y_range > 0 else 0.1
    annotated = set()
    count = 0
    for g1, g2, p in sig_pairs:
        if (g1, g2) in annotated or (g2, g1) in annotated:
            continue
        annotated.add((g1, g2))
        if g1 not in order or g2 not in order:
            continue
        x1, x2 = order.index(g1), order.index(g2)
        y_line = y_max + (count + 1) * offset_step
        ax.plot([x1, x1, x2, x2],
                [y_line, y_line + offset_step * 0.1,
                 y_line + offset_step * 0.1, y_line], lw=1.2, c='k')
        stars = '***' if p < 0.001 else '**' if p < 0.01 \
            else '*' if p < 0.05 else 'ns'
        ax.text((x1 + x2) / 2, y_line + offset_step * 0.15, stars,
                ha='center', va='bottom', fontsize=13)
        count += 1

