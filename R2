def autocorrelation_diagnostics(fit_details, output_dir):
    rows = []
    for sid, det in fit_details.items():
        t = det['t']; y = det['y']; p = det['params']
        if det['model'] == 'single':
            if (np.isnan(p.get('C0_total', np.nan)) or
                    np.isnan(p.get('k_total', np.nan))):
                continue
            yhat = single_pool(t, p['C0_total'], p['k_total'])
        else:
            keys = ['C0_fast', 'k_fast', 'C0_slow', 'k_slow']
            if any(np.isnan(p.get(k, np.nan)) for k in keys):
                continue
            yhat = double_pool(t, p['C0_fast'], p['k_fast'],
                               p['C0_slow'], p['k_slow'])
        e = y - yhat
        try:
            dw = durbin_watson(e)
        except Exception:
            dw = np.nan
        try:
            lb = acorr_ljungbox(e, lags=[1], return_df=True)
            lb_stat = float(lb['lb_stat'].iloc[0])
            lb_p = float(lb['lb_pvalue'].iloc[0])
        except Exception:
            lb_stat, lb_p = np.nan, np.nan
        rows.append({
            'SampleID': sid, 'Years': det['Years'], 'Depth': det['Depth'],
            'Model': det['model'], 'N_points': len(e),
            'Durbin_Watson': dw,
            'LjungBox_lag1_stat': lb_stat,
            'LjungBox_lag1_p': lb_p,
        })
    df_acf = pd.DataFrame(rows)
    df_acf.to_csv(output_dir + "autocorrelation_diagnostics.csv", index=False)
    if len(df_acf) > 0:
        summary = {
            'N_samples': len(df_acf),
            'DW_mean': df_acf['Durbin_Watson'].mean(),
            'DW_median': df_acf['Durbin_Watson'].median(),
            'DW_below_1.5_fraction': (df_acf['Durbin_Watson'] < 1.5).mean(),
            'DW_above_2.5_fraction': (df_acf['Durbin_Watson'] > 2.5).mean(),
            'LjungBox_sig_fraction': (df_acf['LjungBox_lag1_p'] < 0.05).mean(),
        }
        pd.DataFrame([summary]).to_csv(
            output_dir + "autocorrelation_summary.csv", index=False)
        print("\n===== 自相关诊断汇总 =====")
        for k, v in summary.items():
            print(f"  {k}: {v:.4f}" if isinstance(v, float) else f"  {k}: {v}")
    return df_acf

df_acf = autocorrelation_diagnostics(fit_details, output_dir)

def cohens_d(x, y):
    nx, ny = len(x), len(y)
    if nx < 2 or ny < 2:
        return np.nan
    dof = nx + ny - 2
    pooled_std = np.sqrt(
        ((nx - 1) * np.std(x, ddof=1)**2 +
         (ny - 1) * np.std(y, ddof=1)**2) / dof)
    if pooled_std == 0:
        return np.nan
    return (np.mean(x) - np.mean(y)) / pooled_std

