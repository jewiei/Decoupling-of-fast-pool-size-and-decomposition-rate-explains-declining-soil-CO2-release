    print(dat.groupby(['Years', 'Depth']).size().to_string())

    def z(x):
        x = np.asarray(x, dtype=float)
        sd = x.std(ddof=0)
        return (x - x.mean()) / sd if sd > 0 else np.zeros_like(x)

    def make_scores(df):
        out, rows = {}, []
        for name, spec in BLOCKS.items():
            X = df[spec['cols']].astype(float).copy()
            for c in spec['log']:
                X[c] = np.log1p(np.clip(X[c], 0, None))
            Z = StandardScaler().fit_transform(X)
            if len(spec['cols']) == 1:
                score = Z[:, 0]
                load = pd.Series([1.0], index=spec['cols'])
                evr = 1.0
            else:
                pca = PCA(n_components=1).fit(Z)
                load = pd.Series(pca.components_[0], index=spec['cols'])
                if load[spec['anchor']] < 0:
                    load = -load
                score = Z @ load.values
                evr = float(pca.explained_variance_ratio_[0])
            out[name] = z(score)
            for c in spec['cols']:
                rows.append(dict(Block=name, Indicator=c,
                                 Loading=float(load[c]), PC1_EVR=evr))
