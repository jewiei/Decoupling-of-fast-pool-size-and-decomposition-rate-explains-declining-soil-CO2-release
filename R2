def estimate_ar1_rho(residuals):
    e = np.asarray(residuals, dtype=float).flatten()
    if len(e) < 3:
        return 0.0
    e_t = e[1:]
    e_lag = e[:-1]
    denom = np.sum(e_lag ** 2)
    if denom <= 0:
        return 0.0
    rho = np.sum(e_t * e_lag) / denom
    return float(np.clip(rho, -0.95, 0.95))


def estimate_ar1_rho_uneven(t, residuals):
    t = np.asarray(t, dtype=float).flatten()
    e = np.asarray(residuals, dtype=float).flatten()
    if len(t) < 3:
        return 0.0
    dt = np.diff(t)
    e_t = e[1:]
    e_lag = e[:-1]

    def neg_loglik_ar1(rho):
        if rho <= -0.999 or rho >= 0.999:
            return 1e12
        rho_pow = rho ** dt
        var = 1.0 - rho ** (2.0 * dt)
        var = np.clip(var, 1e-10, None)
        resid = (e_t - rho_pow * e_lag) / np.sqrt(var)
        return np.sum(resid ** 2)

    grid = np.linspace(-0.95, 0.95, 381)
    scores = np.array([neg_loglik_ar1(r) for r in grid])
    best_idx = int(np.argmin(scores))
    return float(grid[best_idx])


def ar1_whiten_matrix(t, rho):
    t = np.asarray(t, dtype=float).flatten()
    n = len(t)
    W = np.zeros((n, n))
    W[0, 0] = 1.0
    for i in range(1, n):
        dt = t[i] - t[i - 1]
        rho_pow = rho ** dt
        denom = np.sqrt(max(1.0 - rho ** (2.0 * dt), 1e-12))
        W[i, i] = 1.0 / denom
        W[i, i - 1] = -rho_pow / denom
    return W


def ar1_whiten_residuals(t, e, rho):
    t = np.asarray(t, dtype=float).flatten()
    e = np.asarray(e, dtype=float).flatten()
    n = len(t)
    e_white = np.empty(n)
    e_white[0] = e[0]
    for i in range(1, n):
        dt = t[i] - t[i - 1]
        rho_pow = rho ** dt
        denom = np.sqrt(max(1.0 - rho ** (2.0 * dt), 1e-12))
        e_white[i] = (e[i] - rho_pow * e[i - 1]) / denom
    return e_white


def fit_ar1_gls(t, y, model_func, p0, bounds, max_iter=10, tol=1e-4):
    t = np.asarray(t, dtype=float).flatten()
    y = np.asarray(y, dtype=float).flatten()

    try:
        popt, _ = curve_fit(model_func, t, y, p0=p0, bounds=bounds,
                            maxfev=20000)
    except Exception:
        return None, None

    rho = 0.0
    for _ in range(max_iter):
        res = y - model_func(t, *popt)
        rho_new = estimate_ar1_rho_uneven(t, res)
        if abs(rho_new - rho) < tol:
            rho = rho_new
            break
        rho = rho_new

        try:
            W = ar1_whiten_matrix(t, rho)
        except Exception:
            break

        y_w = W @ y

        def model_whitened(t_, *p):
            return W @ model_func(t_, *p)

        try:
            popt, _ = curve_fit(model_whitened, t, y_w, p0=popt,
                                bounds=bounds, maxfev=20000)
        except Exception:
            break

    res = y - model_func(t, *popt)
    rho_final = estimate_ar1_rho_uneven(t, res)
    return popt, rho_final


