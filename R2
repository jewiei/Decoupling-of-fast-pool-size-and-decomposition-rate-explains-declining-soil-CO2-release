from statsmodels.tools.tools import add_constant


def compute_vif_table(X_df, name_col='Variable'):
    X = X_df.astype(float).dropna().copy()
    n_vars = X.shape[1]
    rows = []
    for i in range(n_vars):
        y_i = X.iloc[:, i].values
        X_others = X.drop(X.columns[i], axis=1)
        X_others_c = add_constant(X_others, has_constant='add')
        try:
            model = sm.OLS(y_i, X_others_c).fit()
            r2 = float(model.rsquared)
            vif = 1.0 / (1.0 - r2) if r2 < 1.0 else np.inf
        except Exception:
            r2, vif = np.nan, np.nan
        flag = ('High' if (not np.isnan(vif) and vif > 10)
                else 'Moderate' if (not np.isnan(vif) and vif > 5)
                else 'OK')
        rows.append({name_col: X.columns[i],
                     'R2_vs_others': r2,
                     'VIF': vif,
                     'Flag': flag})
    return pd.DataFrame(rows).sort_values('VIF', ascending=False).reset_index(drop=True)


