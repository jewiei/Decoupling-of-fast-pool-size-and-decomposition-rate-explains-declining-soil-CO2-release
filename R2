def check_normality_homogeneity(data, dep_var, formula=None):
    sub = data.dropna(subset=[dep_var]).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])

    res = {
        'var': dep_var, 'n_total': len(sub),
        'shapiro_resid_W': np.nan, 'shapiro_resid_p': np.nan,
        'n_cells_tested': 0, 'n_cells_nonnormal': 0,
        'levene_stat': np.nan, 'levene_p': np.nan,
    }
    if formula is None:
        formula = f'Q("{dep_var}") ~ C(Years) + C(Depth) + C(Years):C(Depth)'

    try:
        model = ols(formula, data=sub).fit()
        resid = model.resid.values
        if len(resid) >= 3:
            w, p = shapiro(resid)
            res['shapiro_resid_W'] = float(w)
            res['shapiro_resid_p'] = float(p)
    except Exception:
        pass

    cell_pvals = []
    for _, grp in sub.groupby(['Years', 'Depth']):
        vals = grp[dep_var].dropna().values
        if len(vals) >= 3:
            try:
                _, p = shapiro(vals)
                cell_pvals.append(p)
            except Exception:
                pass
    res['n_cells_tested'] = len(cell_pvals)
    res['n_cells_nonnormal'] = int(sum(1 for p in cell_pvals if p < 0.05))

    groups = [g[dep_var].values for _, g in sub.groupby(['Years', 'Depth'])
              if len(g) >= 2]
    if len(groups) >= 2:
        try:
            stat, p = levene(*groups, center='median')
            res['levene_stat'] = float(stat)
            res['levene_p'] = float(p)
        except Exception:
            pass
    return res


def scheirer_ray_hare(data, dep_var):
    sub = data.dropna(subset=[dep_var]).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])
    sub['_rank'] = rankdata(sub[dep_var].values)
    N = len(sub)
    formula = '_rank ~ C(Years) + C(Depth) + C(Years):C(Depth)'
    model = ols(formula, data=sub).fit()
    aov = sm.stats.anova_lm(model, typ=2)
    denom = N * (N + 1) / 12.0
    rows = []
    for eff in ['C(Years)', 'C(Depth)', 'C(Years):C(Depth)']:
        SS = float(aov.loc[eff, 'sum_sq'])
        df_eff = float(aov.loc[eff, 'df'])
        H = SS / denom if denom > 0 else np.nan
        p = float(chi2.sf(H, df_eff)) if not np.isnan(H) else np.nan
        rows.append({'Effect': eff, 'SS_rank': SS, 'df': df_eff,
                     'H': H, 'p_value': p})
    return pd.DataFrame(rows)


def posthoc_pairwise(data, dep_var, group_col):
    sub = data.dropna(subset=[dep_var, group_col]).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])
    groups = sorted(sub[group_col].unique(), key=lambda x: str(x))
    pairs = list(combinations(groups, 2))
    pvals = []
    pair_list = []
    for g1, g2 in pairs:
        x = sub.loc[sub[group_col] == g1, dep_var].values
        y = sub.loc[sub[group_col] == g2, dep_var].values
        if len(x) >= 2 and len(y) >= 2:
            try:
                _, p = mannwhitneyu(x, y, alternative='two-sided')
            except Exception:
                p = np.nan
        else:
            p = np.nan
        pvals.append(p)
        pair_list.append((g1, g2))
    pvals = np.array(pvals, dtype=float)
    padj = np.full_like(pvals, np.nan)
    reject = np.zeros(len(pvals), dtype=bool)
    valid = ~np.isnan(pvals)
    if valid.sum() > 0:
        rej_v, padj_v, _, _ = multipletests(pvals[valid], method='holm')
        padj[valid] = padj_v
        reject[valid] = rej_v
    return pd.DataFrame({
        'group1': [p[0] for p in pair_list],
        'group2': [p[1] for p in pair_list],
        'p_raw': pvals, 'p_adj_holm': padj, 'reject_0.05': reject,
    })


def anova_tukey(data, dep_var, factors=['Years', 'Depth'], output_dir='',
                 verbose=True):
    sub = data.dropna(subset=[dep_var]).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])
    if verbose:
        print(f"\n   [Assumption checks for {dep_var}: n={len(sub)}]")

    assume = check_normality_homogeneity(sub, dep_var)
    sw_p = assume['shapiro_resid_p']
    norm_ok = (sw_p is not None) and (not np.isnan(sw_p)) and (sw_p > 0.05)
    lev_p = assume['levene_p']
    var_ok = (lev_p is not None) and (not np.isnan(lev_p)) and (lev_p > 0.05)

    if verbose:
        sw_str = (f"W={assume['shapiro_resid_W']:.4f}, p={sw_p:.4f}"
                  if not np.isnan(sw_p) else "W=NA, p=NA")
        lev_str = (f"stat={assume['levene_stat']:.4f}, p={lev_p:.4f}"
                   if not np.isnan(lev_p) else "stat=NA, p=NA")
        print(f"     Shapiro-Wilk on residuals: {sw_str}")
        print(f"     Non-normal cells: {assume['n_cells_nonnormal']}/{assume['n_cells_tested']}")
        print(f"     Levene (Brown-Forsythe): {lev_str}")
        print(f"     Normality OK: {norm_ok}, Variance homogeneity OK: {var_ok}")

    record = {'var': dep_var, **assume,
              'normality_ok': norm_ok, 'variance_ok': var_ok,
              'parametric_used': norm_ok and var_ok,
              'test_used': 'ANOVA+Tukey' if (norm_ok and var_ok)
              else 'SRH+MannWhitney-Holm',
              'Years_p': np.nan, 'Depth_p': np.nan,
              'Years_x_Depth_p': np.nan}

    if norm_ok and var_ok:
        formula = f'Q("{dep_var}") ~ C(Years) + C(Depth) + C(Years):C(Depth)'
        model = ols(formula, data=sub).fit()
        anova_table = sm.stats.anova_lm(model, typ=2)
        if verbose:
            print(f"\n   ========= Parametric two-way ANOVA for {dep_var} =========")
            print(anova_table)
        anova_table.to_csv(output_dir + f"ANOVA_{dep_var}.csv")

        try:
            record['Years_p'] = float(anova_table.loc['C(Years)', 'PR(>F)'])
        except Exception:
            pass
        try:
            record['Depth_p'] = float(anova_table.loc['C(Depth)', 'PR(>F)'])
        except Exception:
            pass
        try:
            record['Years_x_Depth_p'] = float(
                anova_table.loc['C(Years):C(Depth)', 'PR(>F)'])
        except Exception:
            pass

        inter_p = anova_table.loc['C(Years):C(Depth)', 'PR(>F)']
        if inter_p < 0.05:
            for depth in sub['Depth'].unique():
                sub_d = sub[sub['Depth'] == depth]
                if sub_d['Years'].nunique() >= 2:
                    tukey = pairwise_tukeyhsd(sub_d[dep_var], sub_d['Years'])
                    if verbose:
                        print(f"\n   Depth={depth}:\n{tukey}")
                    with open(output_dir + f"tukey_{dep_var}_{depth}.txt", 'w') as f:
                        f.write(str(tukey))
        else:
            for factor in ['Years', 'Depth']:
                if anova_table.loc[f'C({factor})', 'PR(>F)'] < 0.05:
                    if sub[factor].nunique() >= 2:
                        tukey = pairwise_tukeyhsd(sub[dep_var], sub[factor])
                        if verbose:
                            print(f"\n   {factor}:\n{tukey}")
                        with open(output_dir + f"tukey_{dep_var}_{factor}.txt", 'w') as f:
                            f.write(str(tukey))
        try:
            from statsmodels.stats.diagnostic import het_breuschpagan
            bp = het_breuschpagan(model.resid, model.model.exog)
            record['breusch_pagan_p'] = float(bp[1])
        except Exception:
            record['breusch_pagan_p'] = np.nan
        return anova_table, record
    else:
        if verbose:
            print(f"\n   ========= Non-parametric (SRH) for {dep_var} =========")
        srh_table = scheirer_ray_hare(sub, dep_var)
        if verbose:
            print(srh_table)
        srh_table.to_csv(output_dir + f"SRH_{dep_var}.csv", index=False)

        try:
            record['Years_p'] = float(
                srh_table.loc[srh_table['Effect'] == 'C(Years)',
                              'p_value'].values[0])
        except Exception:
            pass
        try:
            record['Depth_p'] = float(
                srh_table.loc[srh_table['Effect'] == 'C(Depth)',
                              'p_value'].values[0])
        except Exception:
            pass
        try:
            record['Years_x_Depth_p'] = float(
                srh_table.loc[srh_table['Effect'] == 'C(Years):C(Depth)',
                              'p_value'].values[0])
        except Exception:
            pass

        inter_p = srh_table.loc[srh_table['Effect'] == 'C(Years):C(Depth)',
                                'p_value'].values[0]
        years_p = srh_table.loc[srh_table['Effect'] == 'C(Years)',
                                'p_value'].values[0]
        depth_p = srh_table.loc[srh_table['Effect'] == 'C(Depth)',
                                'p_value'].values[0]
        if (not np.isnan(inter_p)) and inter_p < 0.05:
            for depth in sub['Depth'].unique():
                sub_d = sub[sub['Depth'] == depth]
                if sub_d['Years'].nunique() >= 2:
                    ph = posthoc_pairwise(sub_d, dep_var, 'Years')
                    if verbose:
                        print(f"\n   Depth={depth} (MW+Holm):\n{ph}")
                    ph.to_csv(output_dir + f"posthoc_{dep_var}_{depth}.csv", index=False)
        else:
            if (not np.isnan(years_p)) and years_p < 0.05 and sub['Years'].nunique() >= 2:
                ph = posthoc_pairwise(sub, dep_var, 'Years')
                if verbose:
                    print(f"\n   Years (MW+Holm):\n{ph}")
                ph.to_csv(output_dir + f"posthoc_{dep_var}_Years.csv", index=False)
            if (not np.isnan(depth_p)) and depth_p < 0.05 and sub['Depth'].nunique() >= 2:
                ph_d = posthoc_pairwise(sub, dep_var, 'Depth')
                if verbose:
                    print(f"\n   Depth (MW+Holm):\n{ph_d}")
                ph_d.to_csv(output_dir + f"posthoc_{dep_var}_Depth.csv", index=False)
        return srh_table, record

