def compute_q2_blindfolding(X, y, omission_distance=7):

    X = np.asarray(X, dtype=float)
    y = np.asarray(y, dtype=float).flatten()
    n = len(y)
    D = omission_distance

    if n <= D or n < 4:
        D = n

    y_pred = np.full(n, np.nan)

    for j in range(D):
        omit_idx = np.arange(j, n, D)
        keep_idx = np.setdiff1d(np.arange(n), omit_idx)

        if len(keep_idx) < X.shape[1] + 1:
            continue

        try:
            model = LinearRegression().fit(X[keep_idx], y[keep_idx])
            y_pred[omit_idx] = model.predict(X[omit_idx])
        except Exception:
            continue

    valid = ~np.isnan(y_pred)
    if valid.sum() == 0:
        return np.nan, np.nan, np.nan

    PRESS = float(np.sum((y[valid] - y_pred[valid]) ** 2))
    SSO = float(np.sum(y ** 2))
    Q2 = 1 - PRESS / SSO if SSO > 0 else np.nan

    return Q2, PRESS, SSO

