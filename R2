def permutation_anova_depth(df_fit, dep_var='k_fast', n_perm=5000,
                            random_state=42, year_order=None):
    rng = np.random.default_rng(random_state)
    sub = df_fit.dropna(subset=[dep_var]).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])

    formula = f'Q("{dep_var}") ~ C(Years) + C(Depth) + C(Years):C(Depth)'

    aov_obs = sm.stats.anova_lm(ols(formula, data=sub).fit(), typ=2)
    F_obs_depth = float(aov_obs.loc['C(Depth)', 'F'])
    p_par_depth = float(aov_obs.loc['C(Depth)', 'PR(>F)'])

    years_vals = sub['Years'].astype(str).values
    depth_vals = sub['Depth'].astype(str).values

    F_null_depth = []
    for _ in range(n_perm):
        depth_perm = depth_vals.copy()
        for y in np.unique(years_vals):
            mask = years_vals == y
            depth_perm[mask] = rng.permutation(depth_vals[mask])
        sub_perm = sub.copy()
        sub_perm['Depth'] = depth_perm
        try:
            a = sm.stats.anova_lm(ols(formula, data=sub_perm).fit(), typ=2)
            F_null_depth.append(float(a.loc['C(Depth)', 'F']))
        except Exception:
            continue

    F_null = np.array(F_null_depth, dtype=float)
    p_perm = (np.sum(F_null >= F_obs_depth) + 1) / (len(F_null) + 1)

    return {
        'F_obs': F_obs_depth,
        'p_perm': float(p_perm),
        'p_parametric_ANOVA': p_par_depth,
        'n_valid_perm': len(F_null),
    }


