def summarize_years_effect(df, param, label):
    sub = df.dropna(subset=[param]).copy()
    if len(sub) < 5:
        return None
    assume = check_normality_homogeneity(sub, param)
    sw = assume['shapiro_resid_p']; lev = assume['levene_p']
    norm_ok = (not np.isnan(sw)) and sw > 0.05
    var_ok = (not np.isnan(lev)) and lev > 0.05
    means = sub.groupby('Years')[param].mean().reindex(year_order)
    if norm_ok and var_ok:
        formula = f'Q("{param}") ~ C(Years) + C(Depth) + C(Years):C(Depth)'
        model = ols(formula, data=sub).fit()
        aov = sm.stats.anova_lm(model, typ=2)
        p_years = aov.loc['C(Years)', 'PR(>F)']
        test = 'ANOVA'
    else:
        srh = scheirer_ray_hare(sub, param)
        p_years = srh.loc[srh['Effect'] == 'C(Years)', 'p_value'].values[0]
        test = 'SRH'
    return {'label': label, 'test': test, 'p_years': p_years,
