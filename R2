    else:
        m_full = sm.OLS(S['k_fast'], X).fit()
    r2 = float(m_full.rsquared)
    r2_adj = float(m_full.rsquared_adj)

    f2 = {}
    for p in preds:
        Xr = sm.add_constant(S[[q for q in preds if q != p]],
                             has_constant='add')
        r2r = sm.OLS(S['k_fast'], Xr).fit().rsquared
        f2[p] = (r2 - r2r) / (1 - r2) if r2 < 1 else np.nan

    vif_full = pd.Series(
        [variance_inflation_factor(X.values, i + 1)
         for i in range(len(preds))], index=preds)

    def lmg(S, y, preds):
        Xv, yv, p = S[preds].values, S[y].values, len(preds)
        r2m = {}
        for mask in range(1 << p):
            cols = [i for i in range(p) if mask & (1 << i)]
            if not cols:
                r2m[mask] = 0.0
                continue
            Xs = np.c_[np.ones(len(Xv)), Xv[:, cols]]
            beta = np.linalg.lstsq(Xs, yv, rcond=None)[0]
            r2m[mask] = 1 - np.sum((yv - Xs @ beta) ** 2) / np.sum(
                (yv - yv.mean()) ** 2)
        out = np.zeros(p)
        for j in range(p):
            others = [i for i in range(p) if i != j]
            for k in range(len(others) + 1):
                w = factorial(k) * factorial(p - k - 1) / factorial(p)
                for sub in combinations(others, k):
                    m0 = sum(1 << i for i in sub)
                    out[j] += w * (r2m[m0 | (1 << j)] - r2m[m0])
        return pd.Series(out, index=preds)

    lmg_tbl = lmg(S, 'k_fast', preds)
    print(f'[LV-LMG] R2 = {r2:.4f}, adj R2 = {r2_adj:.4f}, '
          f'sum(LMG) = {lmg_tbl.sum():.6f}')

    def draw_indices(df, B):
        if 'Quadrat' not in df.columns or df['Quadrat'].nunique() < 3:
            for _ in range(B):
                yield rng.choice(len(df), len(df), replace=True)
            return
        clusters = df['Quadrat'].unique()
        for _ in range(B):
            pick_c = rng.choice(clusters, len(clusters), replace=True)
            yield np.concatenate([np.where(df['Quadrat'].values == c)[0]
