def rebuild_quadrat_id(df, sample_col='SampleID',
                       years_col='Years', depth_col='Depth'):

    df = df.copy()
    df['Quadrat'] = np.nan
    for years in df[years_col].unique():
        sub_y = df[df[years_col] == years]
        depth_str = sub_y[depth_col].astype(str).str.lower()
        top = sub_y[depth_str.str.contains('top', na=False)] \
            .sort_values(sample_col)
        bot = sub_y[depth_str.str.contains('sub|bottom', na=False)] \
            .sort_values(sample_col)
        n_pairs = min(len(top), len(bot))
        for i in range(n_pairs):
            qid = f"{years}_Q{i + 1}"
            df.loc[top.index[i], 'Quadrat'] = qid
            df.loc[bot.index[i], 'Quadrat'] = qid
    df['Quadrat'] = df['Quadrat'].fillna(
        'Unpaired_' + df[sample_col].astype(str))
    return df


def anova_tukey_mixed(data, dep_var, output_dir='', verbose=True):

    from scipy.stats import norm as _norm

    sub = data.dropna(subset=[dep_var, 'Quadrat']).copy()
    sub[dep_var] = pd.to_numeric(sub[dep_var], errors='coerce')
    sub = sub.dropna(subset=[dep_var])

    if sub['Quadrat'].nunique() < 3:
        if verbose:
            print(f"   [MixedLM {dep_var}] Quadrat 水平不足，跳过")
        return None, {'var': dep_var, 'model_type': 'MixedLM_skipped'}

    formula = f"Q('{dep_var}') ~ C(Years) * C(Depth)"
    try:
        md = smf.mixedlm(formula, data=sub, groups=sub['Quadrat'])
        mdf = md.fit(reml=True, method='lbfgs', maxiter=2000)
    except Exception as e:
        if verbose:
            print(f"   [MixedLM {dep_var}] 拟合失败: {e}")
        return None, {'var': dep_var, 'model_type': 'MixedLM_failed',
                      'error': str(e)}

    fe = mdf.fe_params
    fe_names = list(fe.index)
    cov = mdf.cov_params()

    try:
        cov_fe = cov.loc[fe_names, fe_names]
    except Exception:
        cov_fe = np.asarray(cov)[:len(fe_names), :len(fe_names)]

    se = np.sqrt(np.diag(cov_fe))
    z = fe.values / se
    p = 2 * (1 - _norm.cdf(np.abs(z)))

    fixed_effects = pd.DataFrame({
        'Term': fe_names,
        'Coef': fe.values,
        'SE': se,
        'z': z,
        'p': p
    })

    wald_table = None
    try:
        wald_table = mdf.wald_test_terms().table
    except Exception:
        wald_table = None

    def _get_wald_p(key, exclude=None):
        if wald_table is None:
            return np.nan
        for idx in wald_table.index:
            s = str(idx)
            if key in s and (exclude is None or exclude not in s):
                try:
                    return float(wald_table.loc[idx, 'pvalue'])
                except Exception:
                    return np.nan
        return np.nan

    def _get_fe_p(key, exclude=None):
        for _, r in fixed_effects.iterrows():
            s = str(r['Term'])
            if key in s and (exclude is None or exclude not in s):
                return float(r['p'])
        return np.nan

    years_p = _get_wald_p('C(Years)', exclude=':')
    depth_p = _get_wald_p('C(Depth)', exclude=':')
    inter_p = _get_wald_p('C(Years):C(Depth)')
    if np.isnan(years_p):
        years_p = _get_fe_p('C(Years)', exclude=':')
    if np.isnan(depth_p):
        depth_p = _get_fe_p('C(Depth)', exclude=':')
    if np.isnan(inter_p):
        inter_p = _get_fe_p('C(Years):C(Depth)')

    record = {
        'var': dep_var,
        'model_type': 'MixedLM (1|Quadrat)',
        'n_total': len(sub),
        'n_quadrats': int(sub['Quadrat'].nunique()),
        'Years_p': years_p,
        'Depth_p': depth_p,
        'Years_x_Depth_p': inter_p,
        'converged': bool(mdf.converged),
        'log_likelihood': float(mdf.llf),
        'AIC': float(mdf.aic) if hasattr(mdf, 'aic') else np.nan,
        'BIC': float(mdf.bic) if hasattr(mdf, 'bic') else np.nan,
    }

    fixed_effects.to_csv(
        output_dir + f"MixedLM_fixed_effects_{dep_var}.csv", index=False)

    if verbose:
        print(f"\n   ===== MixedLM for {dep_var} "
              f"(random intercept: Quadrat) =====")
        print(fixed_effects.to_string(index=False))
        print(f"   Years p = {record['Years_p']:.4f}, "
              f"Depth p = {record['Depth_p']:.4f}, "
              f"Years×Depth p = {record['Years_x_Depth_p']:.4f}, "
              f"converged = {record['converged']}")
    return fixed_effects, record


