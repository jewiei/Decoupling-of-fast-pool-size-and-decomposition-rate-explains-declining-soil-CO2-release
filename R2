def single_pool(t, C0, k):
    return C0 * (1 - np.exp(-k * t))

def double_pool(t, C0_fast, k_fast, C0_slow, k_slow):
    return (C0_fast * (1 - np.exp(-k_fast * t)) +
            C0_slow * (1 - np.exp(-k_slow * t)))

def calc_aicc(ss_res, n, k):
    if n <= k + 1:
        return np.inf
    if ss_res <= 0:
        ss_res = 1e-12
    aic = n * np.log(ss_res / n) + 2 * k
    aicc = aic + (2 * k * (k + 1)) / (n - k - 1)
    return aicc

def fit_models(sample_data):
    t = sample_data['Day'].values
    y = sample_data['CO2-C/SOC aerob [mg/g]'].values
    n = len(t)
    if n < 4:
        return None
    C0_init = y.max() * 1.1
    k_init = 0.05
    ss_tot = np.sum((y - np.mean(y))**2)
    if ss_tot <= 0:
        ss_tot = 1e-12

    pcov_single = None
    popt_single = None
    try:
        popt_single, pcov_single = curve_fit(
            single_pool, t, y, p0=[C0_init, k_init],
            bounds=(0, [np.inf, 1]), maxfev=10000)
        y_pred_single = single_pool(t, *popt_single)
        ss_res_single = np.sum((y - y_pred_single)**2)
        r2_single = 1 - ss_res_single / ss_tot
        aicc_single = calc_aicc(ss_res_single, n, 2)
    except Exception:
        popt_single = [np.nan, np.nan]
        pcov_single = None
        y_pred_single = None
        r2_single = -np.inf
        aicc_single = np.inf

    pcov_double = None
    popt_double = None
    try:
        p0_double = [C0_init * 0.3, 0.2, C0_init * 0.7, 0.01]
        popt_double, pcov_double = curve_fit(
            double_pool, t, y, p0=p0_double,
            bounds=(0, [np.inf, 1, np.inf, 0.5]), maxfev=10000)
        y_pred_double = double_pool(t, *popt_double)
        ss_res_double = np.sum((y - y_pred_double)**2)
        r2_double = 1 - ss_res_double / ss_tot
        aicc_double = calc_aicc(ss_res_double, n, 4)
    except Exception:
        popt_double = [np.nan, np.nan, np.nan, np.nan]
        pcov_double = None
        y_pred_double = None
        r2_double = -np.inf
        aicc_double = np.inf

    if aicc_single < aicc_double:
        best_model = 'single'
        best_params = {
            'C0_total': popt_single[0], 'k_total': popt_single[1],
            'C0_fast': np.nan, 'k_fast': np.nan,
            'C0_slow': np.nan, 'k_slow': np.nan,
            'R2': r2_single, 'AICc': aicc_single
        }
        best_pcov = pcov_single
        best_popt = popt_single
    else:
        best_model = 'double'
        best_params = {
            'C0_total': popt_double[0] + popt_double[2],
            'k_total': np.nan,
            'C0_fast': popt_double[0], 'k_fast': popt_double[1],
            'C0_slow': popt_double[2], 'k_slow': popt_double[3],
            'R2': r2_double, 'AICc': aicc_double
        }
        best_pcov = pcov_double
        best_popt = popt_double
    return {
        'model': best_model, 'params': best_params,
        'pcov': best_pcov, 'popt': best_popt,        # ===== 新增 =====
        't': t, 'y': y,
        'y_pred_single': y_pred_single, 'y_pred_double': y_pred_double,
        'r2_single': r2_single, 'r2_double': r2_double,
        'aicc_single': aicc_single, 'aicc_double': aicc_double
    }

