    year_num_map = {'Control': 0, '1 year': 1, '12 years': 12, '23 years': 23}
    df_ph['Years_num'] = df_ph['Years'].astype(str).map(year_num_map)
    print(f"  有效样本数: n = {len(df_ph)}")
    print(f"  分组样本数:\n{df_ph.groupby(['Years','Depth']).size().to_string()}")

    ph_desc = df_ph.groupby(['Years', 'Depth'])[PH_COL] \
                   .agg(['mean', 'std', 'count']).round(3).reset_index()
    ph_desc['se'] = (ph_desc['std'] / np.sqrt(ph_desc['count'])).round(3)
    ph_desc.to_csv(output_dir + "TableSX_pH_descriptive.csv", index=False)
    print("\n===== [1] pH 描述性统计（Mean ± SD）=====")
    print(ph_desc.to_string(index=False))

    ph_anova_tbl, ph_rec = anova_tukey(
        df_ph, PH_COL, factors=['Years', 'Depth'],
        output_dir=output_dir + "pH_", verbose=True)

    print("\n===== [2] pH 双因素检验汇总 =====")
    print(f"  检验方法        : {ph_rec['test_used']}")
    print(f"  Shapiro 残差 p  : {ph_rec.get('shapiro_resid_p', np.nan):.4f}")
    print(f"  Levene p        : {ph_rec.get('levene_p', np.nan):.4f}")
    print(f"  Years 主效应 p  : {ph_rec.get('Years_p', np.nan):.4f}")
    print(f"  Depth 主效应 p  : {ph_rec.get('Depth_p', np.nan):.4f}")
    print(f"  Years×Depth p   : {ph_rec.get('Years_x_Depth_p', np.nan):.4f}")

    p_years = ph_rec.get('Years_p', np.nan)
    p_depth = ph_rec.get('Depth_p', np.nan)
    p_inter = ph_rec.get('Years_x_Depth_p', np.nan)

    def _stars(p):
        if p is None or np.isnan(p):
            return 'NA'
        return '***' if p < 0.001 else '**' if p < 0.01 else '*' if p < 0.05 else 'ns'

    print("\n  [判读]")
    if not np.isnan(p_years):
        print(f"    Years 主效应 {_stars(p_years)}: "
              f"pH 随恢复年限{'存在显著变化' if p_years < 0.05 else '无显著变化'}")
    if not np.isnan(p_inter) and p_inter < 0.05:
        print("    Years×Depth 交互显著 → 表土/底土的 pH 变化轨迹不同，"
              "应分层报告（anova_tukey 已自动按 Depth 分层做 Tukey/MW-Holm）")
    else:
        print("    交互不显著 → 可报告 Years 主效应整体结果")

    print("\n===== [3] pH 整体 Years 两两比较（Mann-Whitney + Holm，稳健补充） =====")
    ph_posthoc_overall = posthoc_pairwise(df_ph, PH_COL, 'Years')
    ph_posthoc_overall.to_csv(
        output_dir + "pH_posthoc_Years_MW_Holm.csv", index=False)
    print(ph_posthoc_overall.to_string(index=False))

    print("\n===== [4] pH 随年限的线性趋势检验 =====")
    trend_rows = []
    for depth_label in ['Overall'] + list(df_ph['Depth'].unique()):
        sub = df_ph if depth_label == 'Overall' \
                    else df_ph[df_ph['Depth'] == depth_label]
        sub = sub.dropna(subset=[PH_COL, 'Years_num'])
        if len(sub) < 4:
            continue
        X = sm.add_constant(sub['Years_num'].values.astype(float))
        m = sm.OLS(sub[PH_COL].values.astype(float), X).fit()
        slope = float(m.params[1])
        p_trend = float(m.pvalues[1])
        r = float(np.corrcoef(sub['Years_num'], sub[PH_COL])[0, 1])
        rho_s, p_s = stats.spearmanr(sub['Years_num'], sub[PH_COL])
        trend_rows.append({
            'Scope': depth_label,
            'N': len(sub),
            'Slope_pH_per_year': slope,
            'p_linear_trend': p_trend,
            'Pearson_r': r,
            'Spearman_rho': float(rho_s),
            'Spearman_p': float(p_s),
            'Significance': _stars(p_trend),
        })
        print(f"  [{depth_label:8s}] slope = {slope:+.4f} pH/yr, "
              f"线性趋势 p = {p_trend:.4f} {_stars(p_trend)}, "
              f"Spearman ρ = {rho_s:+.3f} (p = {p_s:.4f}), n = {len(sub)}")
    df_trend = pd.DataFrame(trend_rows)
    df_trend.to_csv(output_dir + "pH_trend_by_Depth.csv", index=False)

    try:
        sub_poly = df_ph.dropna(subset=[PH_COL]).copy()
        formula_poly = (f'Q("{PH_COL}") ~ C(Years, Poly) + C(Depth)')
        model_poly = smf.ols(formula_poly, data=sub_poly).fit()
        aov_poly = sm.stats.anova_lm(model_poly, typ=2)
        print("\n  [4b] 正交多项式对比（C(Years, Poly)）：")
        print(aov_poly.to_string())
        lin_terms = [i for i in aov_poly.index
                     if 'Poly' in i and 'Depth' not in i]
        for term in lin_terms:
            print(f"    {term}: F = {aov_poly.loc[term, 'F']:.3f}, "
                  f"p = {aov_poly.loc[term, 'PR(>F)']:.4f} "
                  f"{_stars(aov_poly.loc[term, 'PR(>F)'])}")
        aov_poly.to_csv(output_dir + "pH_orthogonal_polynomial.csv")
    except Exception as e:
        print(f"  正交多项式对比跳过: {e}")

    print("\n===== [5] pH 效应量（Cohen's d，23 years vs Control） =====")
    ph_effect_rows = []
    for depth_label in df_ph['Depth'].unique():
        x = df_ph[(df_ph['Years'] == '23 years') &
                  (df_ph['Depth'] == depth_label)][PH_COL].dropna()
        y = df_ph[(df_ph['Years'] == 'Control') &
                  (df_ph['Depth'] == depth_label)][PH_COL].dropna()
        if len(x) > 1 and len(y) > 1:
            d = cohens_d(x, y)
            ph_effect_rows.append({
                'Depth': depth_label,
                'n_23yr': len(x), 'n_Control': len(y),
                'mean_23yr': x.mean(), 'mean_Control': y.mean(),
                'delta': x.mean() - y.mean(),
                "Cohens_d": d,
            })
            print(f"  [Depth={depth_label}] Δ = {x.mean() - y.mean():+.3f} pH, "
                  f"Cohen's d = {d:+.3f}")
    df_ph_effect = pd.DataFrame(ph_effect_rows)
    if len(df_ph_effect) > 0:
        df_ph_effect.to_csv(output_dir + "pH_effect_sizes.csv", index=False)

    fig, axes = plt.subplots(1, 2, figsize=(13, 5))

    sns.pointplot(data=df_ph, x='Years', y=PH_COL, hue='Depth',
                  order=year_order, palette='deep', ax=axes[0],
                  capsize=0.12, errwidth=1.6, markers='o',
                  linestyles='-', dodge=0.15)
    sns.stripplot(data=df_ph, x='Years', y=PH_COL, hue='Depth',
                  order=year_order, palette='deep', ax=axes[0],
                  dodge=0.15, alpha=0.45, size=5,
                  edgecolor='gray', linewidth=0.4)
    axes[0].set_xlabel('Recovery year')
    axes[0].set_ylabel('pH')
    axes[0].set_title('(a) pH across recovery years\n(mean ± SE, split by depth)',
                      fontsize=12, fontweight='bold')
    axes[0].text(0.02, 0.97,
                 f"Years p = {p_years:.4f} {_stars(p_years)}\n"
                 f"Depth p = {p_depth:.4f} {_stars(p_depth)}\n"
                 f"Interaction p = {p_inter:.4f} {_stars(p_inter)}",
                 transform=axes[0].transAxes, va='top', ha='left', fontsize=9,
                 bbox=dict(facecolor='white', alpha=0.85,
                           edgecolor='lightgray', boxstyle='round,pad=0.3'))
    axes[0].legend(title='Depth', loc='lower right', fontsize=9, frameon=True)

    sns.boxplot(data=df_ph, x='Years', y=PH_COL, order=year_order,
                palette='Set2', ax=axes[1], width=0.6,
                linewidth=0.8, showfliers=False)
    sns.stripplot(data=df_ph, x='Years', y=PH_COL, order=year_order,
                  color='black', ax=axes[1], alpha=0.55, size=5,
                  edgecolor='white', linewidth=0.3)
    axes[1].set_xlabel('Recovery year')
    axes[1].set_ylabel('pH')
    axes[1].set_title('(b) pH distribution by recovery year (all depths)',
                      fontsize=12, fontweight='bold')
    plt.tight_layout()
    plt.savefig(output_dir + "FigSX_pH_vs_Years.png", dpi=600)
    plt.close()
    print("\n已输出: FigSX_pH_vs_Years.png")

    ph_summary = pd.DataFrame([{
        'Variable': PH_COL,
        'Test_used': ph_rec['test_used'],
        'N_total': ph_rec['n_total'],
        'Shapiro_resid_p': ph_rec.get('shapiro_resid_p', np.nan),
        'Levene_p': ph_rec.get('levene_p', np.nan),
        'Years_p': p_years,
        'Years_sig': _stars(p_years),
        'Depth_p': p_depth,
        'Depth_sig': _stars(p_depth),
        'Years_x_Depth_p': p_inter,
        'Interaction_sig': _stars(p_inter),
        'Linear_trend_p_overall': df_trend.loc[
            df_trend['Scope'] == 'Overall', 'p_linear_trend'].values[0]
            if (df_trend['Scope'] == 'Overall').any() else np.nan,
        'Linear_trend_slope_overall': df_trend.loc[
            df_trend['Scope'] == 'Overall', 'Slope_pH_per_year'].values[0]
            if (df_trend['Scope'] == 'Overall').any() else np.nan,
    }])
    ph_summary.to_csv(output_dir + "TableSX_pH_significance_summary.csv",
                      index=False)
    print("\n===== [7] pH 显著性汇总表 =====")
    print(ph_summary.T.to_string())
    print("\n已输出: TableSX_pH_significance_summary.csv")
    print("=" * 70)
