    rk = B.rank(axis=1, ascending=False)
    freq = pd.Series({p: float((rk[p] <= 3).mean()) for p in preds})
    mean_rank = rk.mean()

    rank_tbl = pd.DataFrame({
        'LMG': lmg_tbl,
        'LMG_pct': lmg_tbl / r2 * 100 if r2 > 0 else np.nan,
        'f2': pd.Series(f2),
        'VIF': vif_full,
        'CI_low': ci['CI_low'],
        'CI_high': ci['CI_high'],
        'Top3_freq': freq,
        'Mean_rank': mean_rank,
    }).sort_values('LMG', ascending=False)
    rank_tbl.insert(0, 'Rank', np.arange(1, len(rank_tbl) + 1))
    rank_tbl['Top3_robust'] = ((rank_tbl['Rank'] <= 3) &
                               (rank_tbl['Top3_freq'] >= .70))
    rank_tbl.to_csv(OUT + 'rank.csv', index_label='Block')
    B.to_csv(OUT + 'bootstrap_raw.csv', index=False)

    print('\n[LV-LMG] LMG ranking:')
    print(rank_tbl.round(3).to_string())

